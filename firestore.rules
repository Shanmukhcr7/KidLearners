rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────
    function isSignedIn()    { return request.auth != null; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin()  { return isSignedIn() && getUserData().role == 'superadmin'; }
    function isSchoolAdmin() { return isSignedIn() && (getUserData().role == 'school_admin' || getUserData().role == 'admin'); }
    function isStudent()     { return isSignedIn() && getUserData().role == 'student'; }

    function isAdminOrSuperAdmin() { return isSchoolAdmin() || isSuperAdmin(); }

    function isMySchool(schoolId) {
      return isSignedIn() && getUserData().schoolId == schoolId;
    }

    function isMe(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ─── Schools ─────────────────────────────────────────────────────────
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Users ──────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own profile, admins can read everyone, students can read peers in same school (for leaderboard)
      allow read: if isMe(userId) || isAdminOrSuperAdmin() || (isSignedIn() && resource.data.schoolId == getUserData().schoolId);
      
      // Users can create their own profile (happens on signup)
      allow create: if isMe(userId);
      
      // Users can update their own profile (name, avatar, etc)
      // They CANNOT upgrade their own role or schoolId
      allow update: if (isMe(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'schoolId']))
                    || isSuperAdmin() 
                    || (isSchoolAdmin() && isMySchool(resource.data.schoolId));
                    
      allow delete: if isSuperAdmin();
    }

    // ─── Subjects ────────────────────────────────────────────────────────
    match /subjects/{subjectId} {
      allow read:  if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Chapters ────────────────────────────────────────────────────────
    match /chapters/{chapterId} {
      allow read:  if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Quizzes ─────────────────────────────────────────────────────────
    // Students CANNOT read quizzes (correctIndex values must stay server-side)
    // Grading happens via API route using Admin SDK
    match /quizzes/{quizId} {
      allow read:  if isAdminOrSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ─── Student Chapter Progress ─────────────────────────────────────────
    match /studentChapterProgress/{studentId}/chapters/{chapterId} {
      // Students can read their own progress
      allow read: if isMe(studentId) || isAdminOrSuperAdmin();
      allow create, update: if isMe(studentId);
      allow delete: if false; // Never delete progress
    }

    // ─── Projects ────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read:  if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Project Submissions ──────────────────────────────────────────────
    match /studentProjectSubmissions/{submissionId} {
      allow read:  if isSignedIn() && (isAdminOrSuperAdmin() || resource.data.studentId == request.auth.uid);
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSuperAdmin(); // Admin reviews
    }

    // ─── Chat Sessions ────────────────────────────────────────────────────
    match /chatSessions/{studentId}/subjects/{subjectId}/messages/{messageId} {
      allow read, write: if isMe(studentId);
      allow read: if isAdminOrSuperAdmin(); // Moderation
    }

    // ─── Certificates ─────────────────────────────────────────────────────
    match /certificates/{certId} {
      allow read:  if isSignedIn() && (isAdminOrSuperAdmin() || resource.data.studentId == request.auth.uid);
      allow write: if isSuperAdmin(); // Generated by Cloud Function
    }

    // ─── Audit Log ────────────────────────────────────────────────────────
    match /adminAuditLog/{logId} {
      allow read:  if isSuperAdmin();
      allow write: if false; // Written only by Cloud Functions
    }

    // ─── Phase 2: Workshops, Blogs, Gallery ───────────────────────────────
    match /workshops/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSuperAdmin();
    }
    match /blogs/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSuperAdmin();
    }
    match /gallery/{docId} {
      allow read:  if true; // Public for landing page
      // School admins can create/update gallery items for their own school
      allow write: if isSuperAdmin() || (isSchoolAdmin() && request.resource.data.schoolId == getUserData().schoolId);
    }

    // ─── Phase 2: Tasks & Exams ───────────────────────────────────────────
    match /tasks/{taskId} {
      allow read:  if isSignedIn();
      allow write: if isSuperAdmin() || (isSchoolAdmin() && request.resource.data.schoolId == getUserData().schoolId);
    }
    match /exams/{examId} {
      allow read:  if isSignedIn();
      allow write: if isSuperAdmin() || (isSchoolAdmin() && request.resource.data.schoolId == getUserData().schoolId);
    }

    // ─── Notifications ────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:  if isMe(resource.data.userId);
      allow write: if isSuperAdmin() || isSchoolAdmin(); // Admins create notifications
    }
    // ─── Settings ─────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if true; // Public for landing page
      allow write: if isSuperAdmin();
    }
  }
}
