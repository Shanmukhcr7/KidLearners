rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Admins (superadmins and school admins) can read and write media
    match /media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                   (request.auth.token.role == 'superadmin' || request.auth.token.role == 'admin');
    }
    
    // Public read for profile pictures
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Gallery images (Public read, admin write)
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Settings images (Public read, admin write)
    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
